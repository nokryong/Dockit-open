{
  "name": "dockit-open",
  "version": "0.1.3",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-desktop.cjs --dev",
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "start": "node scripts/start-desktop.cjs",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:g1c": "playwright test tests/e2e/pdf-output-preflight.spec.js",
    "test:e2e:g1d": "playwright test tests/e2e/output-fixture-matrix-pdf.spec.js",
    "test:e2e:n6c": "playwright test tests/e2e/n6c-note-durability-pdf.spec.js",
    "test:watch": "vitest",
    "test:conversion:fixtures": "vitest run tests/unit/irDOCXRealFixtureImport.test.js tests/unit/irDOCXSemanticGoldenValidation.test.js tests/unit/irHWPXImportExportRoundTripSmoke.test.js tests/unit/irHWPXVisualGoldenValidation.test.js tests/unit/irNativeNoteInteroperabilityCorpus.test.js",
    "check:readonly-viewer-performance": "vitest run tests/unit/largeDocumentPerformanceSmoke.test.js",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "licenses:refresh-evidence": "node scripts/generate-third-party-notices.mjs --refresh",
    "security:check": "node scripts/check-security-snapshot.mjs",
    "security:refresh-snapshot": "node scripts/check-security-snapshot.mjs --refresh",
    "security:audit-live": "node scripts/live-audit-policy.mjs",
    "test:local": "node --test tests/local/*.test.cjs",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:chatgpt": "node scripts/chatgpt-smoke.cjs",
    "test:codex": "node scripts/codex-smoke.cjs"
  },
