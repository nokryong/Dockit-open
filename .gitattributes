# 저장소 안 텍스트 파일은 LF로 저장 (작업 사본 줄 끝은 각자 Git 설정을 따름)
* text=auto
# 테스트 고정 자료와 .dkt 문서는 변환 제외 (바이트 그대로 비교)
tests/fixtures/** -text
*.dkt -text
/package-lock.json text eol=lf
/licenses/third-party-notices.manifest.json text eol=lf
/public/THIRD_PARTY_NOTICES.txt text eol=lf
/security/production-audit-snapshot.json text eol=lf
